    Hypergeometric["Hypergeometric(N,K,n)<br/>N=pop size, K=success states, n=draws<br/>E[X]=n*K/N<br/>Var=n*(K/N)*(1-K/N)*(N-n)/(N-1)<br/>E[X^2]=Var+E[X]^2"]
    DiscreteUniform["Discrete Uniform(a,b)<br/>a,b = min and max integer<br/>E[X]=(a+b)/2<br/>Var=((b-a+1)^2-1)/12<br/>E[X^2]=Var+E[X]^2"]
    Poisson["Poisson(lambda)<br/>lambda = rate of events<br/>E[X]=lambda<br/>Var=lambda<br/>E[X^2]=lambda+lambda^2"]
