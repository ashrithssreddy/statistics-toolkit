    classDef low fill:#f4cccc,stroke:#a61c00,stroke-width:2px,color:#000;

    class Bernoulli,Binomial,Poisson,Normal,Uniform,ChiSquare,F,T high;
    class NegBinomial,Geometric,Multinomial,Hypergeometric,Exponential medium;
    class DiscreteUniform,Lognormal,Gamma,Beta low;