    Lognormal["Lognormal(mu,sigma2)<br/>mu,sigma2 = mean/var of logX<br/>E[X]=exp(mu+sigma2/2)<br/>Var=(exp(sigma2)-1)*exp(2mu+sigma2)<br/>E[X^2]=Var+E[X]^2"]
    Exponential["Exponential(lambda)<br/>lambda = rate<br/>E[X]=1/lambda<br/>Var=1/lambda^2<br/>E[X^2]=2/lambda^2"]
    Gamma["Gamma(k,theta)<br/>k = shape, theta = scale<br/>E[X]=k*theta<br/>Var=k*theta^2<br/>E[X^2]=Var+E[X]^2"]
    Beta["Beta(alpha,beta)<br/>alpha,beta = shape params<br/>E[X]=alpha/(alpha+beta)<br/>Var=alpha*beta/((alpha+beta)^2*(alpha+beta+1))<br/>E[X^2]=Var+E[X]^2"]
    Uniform["Uniform(a,b)<br/>a,b = min and max<br/>E[X]=(a+b)/2<br/>Var=(b-a)^2/12<br/>E[X^2]=Var+E[X]^2"]
    ChiSquare["Chi-square(nu)<br/>nu = degrees of freedom<br/>E[X]=nu<br/>Var=2*nu<br/>E[X^2]=Var+E[X]^2"]
    F["F(d1,d2)<br/>d1,d2 = degrees of freedom<br/>E[X]=d2/(d2-2), d2>2<br/>Var=complex, depends on d1,d2<br/>E[X^2]=Var+E[X]^2"]
    T["Student t(nu)<br/>nu = degrees of freedom<br/>E[X]=0, nu>1<br/>Var=nu/(nu-2), nu>2<br/>E[X^2]=Var"]

